# The official slim Python image, pinned by its multi-platform digest.
FROM docker.io/library/python:3.11-slim@sha256:9534e5a8e315485d4061ed659af0fd78a284c015f9b73661b41d6bab25604534

# Python writes no bytecode beside the source the experiment runs from the workspace.
ENV PYTHONDONTWRITEBYTECODE=1
