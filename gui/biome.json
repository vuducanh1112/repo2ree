{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "src/**/*.{ts,tsx}",
      "src/**/*.css",
      "scripts/**/*.mjs",
      "!src/shell/infra/api/generated/**",
      "!src/core/generated/**",
      "!dist",
      "!node_modules",
      "!.vite",
      "!build",
      "tests/**/*.{ts,tsx}",
      "playwright.config.ts",
      "vite.config.mjs",
      "testArtifacts.cjs",
      "testArtifacts.d.cts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "warn"
      },
      "suspicious": {
        "noConsole": "warn",
        "noExplicitAny": "warn"
      },
      "style": {
        "useImportType": "error",
        "noNonNullAssertion": "warn",
        "useTemplate": "error",
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "conventions": [
              {
                "selector": {
                  "kind": "typeProperty"
                },
                "match": "__brand|acquire_source|activate_experiment_environment|build_experiment_environment|check_working_environment|cross_check_sbom|evaluate_reproducibility|experiment_run|experiment_verify|generate_sbom|initialize_ree|lint_scripts|load_ree_bundle|materialize_workspace|observe_hardware|patch_ree_definition|remove_source|review_acquire_source|review_activate_experiment_environment|review_build_experiment_environment|review_run_experiment|run_experiment|seal_ree|suggest_scripts|write_script|(.+)",
                "formats": [
                  "camelCase",
                  "PascalCase",
                  "CONSTANT_CASE"
                ]
              },
              {
                "selector": {
                  "kind": "objectLiteralProperty"
                },
                "match": "acquire_source|activate_experiment_environment|build_experiment_environment|check_working_environment|cross_check_sbom|evaluate_reproducibility|experiment_run|experiment_verify|generate_sbom|initialize_ree|lint_scripts|load_ree_bundle|materialize_workspace|observe_hardware|patch_ree_definition|remove_source|review_acquire_source|review_activate_experiment_environment|review_build_experiment_environment|review_run_experiment|run_experiment|seal_ree|suggest_scripts|write_script|(.+)",
                "formats": [
                  "camelCase",
                  "PascalCase",
                  "CONSTANT_CASE"
                ]
              },
              {
                "selector": {
                  "kind": "variable"
                },
                "formats": [
                  "camelCase",
                  "PascalCase",
                  "CONSTANT_CASE"
                ]
              }
            ]
          }
        },
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "filenameCases": [
              "camelCase",
              "PascalCase"
            ]
          }
        }
      },
      "a11y": {
        "recommended": true
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    },
    "globals": [
      "React"
    ]
  },
  "css": {
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": true
    }
  },
  "overrides": [
    {
      "includes": [
        "scripts/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "*.test.ts",
        "*.test.tsx",
        "*.spec.ts",
        "*.spec.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/shell/infra/api/**",
        "src/shell/data/**",
        "src/core/ree/**",
        "src/core/ree-steps/**",
        "src/core/workspace/**",
        "src/core/evaluate/**",
        "src/core/hbom/**",
        "src/core/receipts/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "strictCase": false,
                "conventions": [
                  {
                    "selector": {
                      "kind": "typeProperty"
                    },
                    "match": "__brand|(.+)",
                    "formats": [
                      "camelCase",
                      "PascalCase",
                      "CONSTANT_CASE",
                      "snake_case"
                    ]
                  },
                  {
                    "selector": {
                      "kind": "objectLiteralProperty"
                    },
                    "formats": [
                      "camelCase",
                      "PascalCase",
                      "CONSTANT_CASE",
                      "snake_case"
                    ]
                  },
                  {
                    "selector": {
                      "kind": "variable"
                    },
                    "formats": [
                      "camelCase",
                      "PascalCase",
                      "CONSTANT_CASE"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "tests/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "strictCase": false,
                "filenameCases": [
                  "camelCase",
                  "kebab-case"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
