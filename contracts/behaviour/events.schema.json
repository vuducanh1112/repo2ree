{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repo2ree:contracts:behaviour:events",
  "title": "repo2ree behaviour journal record",
  "description": "One line of a behaviour journal. Generated from specifications/behaviour/vocabulary by `python -m repo2ree_conformance generate`; do not edit. Sequence, epochs, and the header are checked per journal by `python -m repo2ree_conformance validate-journal`.",
  "x-vocabulary": "sha256:936aa79854f379d5ae2f102f597233f24e3c16ac7ffe7a21d00b987a1aeba62e",
  "type": "object",
  "properties": {
    "v": {
      "const": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "at": {
      "type": "string"
    }
  },
  "required": [
    "v",
    "seq",
    "kind"
  ],
  "oneOf": [
    {
      "$ref": "#/$defs/journal.opened"
    },
    {
      "$ref": "#/$defs/journal.closed"
    },
    {
      "$ref": "#/$defs/undeclared"
    },
    {
      "$ref": "#/$defs/Allocation"
    },
    {
      "$ref": "#/$defs/Attempt"
    },
    {
      "$ref": "#/$defs/AuthorApiAction"
    },
    {
      "$ref": "#/$defs/Ree"
    },
    {
      "$ref": "#/$defs/Step"
    },
    {
      "$ref": "#/$defs/dispatch"
    }
  ],
  "$defs": {
    "journal.opened": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "journal.opened"
        },
        "process": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "epoch": {
          "type": "integer",
          "minimum": 1
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "vocabulary": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "kind",
        "process",
        "epoch",
        "hosts",
        "vocabulary"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "process": {
                "const": "api"
              }
            }
          },
          "then": {
            "properties": {
              "hosts": {
                "const": [
                  "api",
                  "supervisor"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "process": {
                "const": "workbench"
              }
            }
          },
          "then": {
            "properties": {
              "hosts": {
                "const": [
                  "core",
                  "workbench"
                ]
              }
            }
          }
        }
      ]
    },
    "journal.closed": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "journal.closed"
        },
        "final": {
          "const": true
        }
      },
      "required": [
        "kind"
      ]
    },
    "undeclared": {
      "description": "A subject the vocabulary does not declare: the owner's own, never judged.",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "transition",
            "send",
            "receive",
            "abandon"
          ]
        },
        "subject": {
          "type": "string",
          "not": {
            "enum": [
              "Allocation",
              "Attempt",
              "AuthorApiAction",
              "Ree",
              "Step",
              "dispatch"
            ]
          }
        },
        "owner": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "facts": {
          "type": "object"
        }
      },
      "required": [
        "kind",
        "subject",
        "owner",
        "key"
      ]
    },
    "Allocation": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "transition"
        },
        "subject": {
          "const": "Allocation"
        },
        "owner": {
          "const": "supervisor"
        },
        "key": {
          "type": "string"
        },
        "partition": {
          "type": [
            "string",
            "null"
          ]
        },
        "from": {
          "enum": [
            null,
            "requested",
            "provisioning",
            "waiting_for_workbench",
            "ready",
            "assigned",
            "draining",
            "released",
            "failed",
            "lost"
          ]
        },
        "to": {
          "enum": [
            "requested",
            "provisioning",
            "waiting_for_workbench",
            "ready",
            "assigned",
            "draining",
            "released",
            "failed",
            "lost"
          ]
        },
        "facts": {
          "type": "object",
          "properties": {
            "detail": {
              "type": [
                "string",
                "null"
              ]
            },
            "location_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "provider_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "workbench_id": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "required": [
        "kind",
        "subject",
        "owner",
        "key",
        "to"
      ],
      "description": "Bookkeeping for obtaining, holding, and returning one workbench for one REE. Evidence: journal."
    },
    "Attempt": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "transition"
        },
        "subject": {
          "const": "Attempt"
        },
        "owner": {
          "const": "core"
        },
        "key": {
          "type": "string"
        },
        "partition": {
          "type": [
            "string",
            "null"
          ]
        },
        "from": {
          "enum": [
            null,
            "pending",
            "executing",
            "completed",
            "captured",
            "capture_failed"
          ]
        },
        "to": {
          "enum": [
            "pending",
            "executing",
            "completed",
            "captured",
            "capture_failed"
          ]
        },
        "facts": {
          "type": "object",
          "properties": {
            "changed": {
              "type": "boolean"
            },
            "commit": {
              "type": "string"
            },
            "dispatched_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "error": {
              "type": "string"
            },
            "operation": {
              "type": "string"
            },
            "outcome": {
              "enum": [
                "succeeded",
                "failed",
                "canceled"
              ]
            },
            "run_id": {
              "type": "string"
            },
            "scope": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "kind",
        "subject",
        "owner",
        "key",
        "to"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "to": {
                "enum": [
                  "captured"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "facts": {
                "type": "object",
                "properties": {
                  "changed": {
                    "type": "boolean"
                  },
                  "commit": {
                    "type": "string"
                  },
                  "dispatched_by": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "error": {
                    "type": "string"
                  },
                  "operation": {
                    "type": "string"
                  },
                  "outcome": {
                    "enum": [
                      "succeeded",
                      "failed",
                      "canceled"
                    ]
                  },
                  "run_id": {
                    "type": "string"
                  },
                  "scope": {
                    "type": "string"
                  }
                },
                "required": [
                  "changed",
                  "commit"
                ]
              }
            },
            "required": [
              "facts"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "to": {
                "enum": [
                  "completed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "facts": {
                "type": "object",
                "properties": {
                  "changed": {
                    "type": "boolean"
                  },
                  "commit": {
                    "type": "string"
                  },
                  "dispatched_by": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "error": {
                    "type": "string"
                  },
                  "operation": {
                    "type": "string"
                  },
                  "outcome": {
                    "enum": [
                      "succeeded",
                      "failed",
                      "canceled"
                    ]
                  },
                  "run_id": {
                    "type": "string"
                  },
                  "scope": {
                    "type": "string"
                  }
                },
                "required": [
                  "outcome"
                ]
              }
            },
            "required": [
              "facts"
            ]
          }
        }
      ],
      "description": "One command execution inside an REE, from its pending record to its published capture. Evidence: git."
    },
    "AuthorApiAction": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "transition"
        },
        "subject": {
          "const": "AuthorApiAction"
