              ]
            },
            "action": {
              "enum": [
                "create_ree",
                "release_workbench",
                "acquire_source",
                "upload_source",
                "remove_source",
                "edit_definition",
                "write_file",
                "delete_file",
                "suggest_scripts",
                "lint_scripts",
                "evaluate_reproducibility",
                "observe_hardware",
                "build_runtime",
                "generate_sbom",
                "cross_check_sbom",
                "test_activation",
                "run_experiment",
                "seal_ree",
                "load_ree_bundle",
                "view_ree",
                "view_ree_state",
                "read_file",
                "list_receipts",
                "view_history",
                "view_evaluation_report",
                "download_ree",
                "list_actions",
                "view_action",
                "view_action_log",
                "watch_action"
              ]
            },
            "allocation_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "attempt_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "experiment": {
              "type": [
                "string",
                "null"
              ]
            },
            "failure_category": {
              "type": [
                "string",
                "null"
              ]
            },
            "http_status": {
              "type": [
