    "dispatch": {
      "description": "One typed command sent to a workbench and the single outcome the sender observed.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "send"
            },
            "subject": {
              "const": "dispatch"
            },
            "owner": {
              "const": "supervisor"
            },
            "key": {
              "type": "string"
            },
            "partition": {
              "type": [
                "string",
                "null"
              ]
            },
            "message": {
              "enum": [
                "exec_action"
              ]
            }
          },
          "required": [
            "kind",
            "subject",
            "owner",
            "key",
            "message"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "message": {
                    "const": "exec_action"
                  }
                }
              },
              "then": {
                "properties": {
                  "facts": {
                    "type": "object",
                    "properties": {
                      "operation": {
                        "type": "string"
                      },
                      "run_id": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "receive"
            },
            "subject": {
              "const": "dispatch"
            },
            "owner": {
              "const": "supervisor"
            },
            "key": {
              "type": "string"
            },
            "partition": {
              "type": [
                "string",
                "null"
              ]
            },
            "message": {
              "enum": [
                "result",
                "unavailable",
                "error"
              ]
            }
          },
          "required": [
            "kind",
            "subject",
            "owner",
            "key",
            "message"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "message": {
                    "const": "result"
                  }
                }
              },
              "then": {
                "properties": {
                  "facts": {
                    "type": "object",
                    "properties": {
                      "commit": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "status": {
                        "enum": [
                          "succeeded",
                          "failed",
                          "canceled"
                        ]
                      }
                    },
                    "required": [
                      "status"
                    ]
                  }
                },
                "required": [
                  "facts"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "message": {
                    "const": "unavailable"
                  }
                }
              },
              "then": {
                "properties": {
                  "facts": {
                    "type": "object",
                    "properties": {}
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "message": {
                    "const": "error"
                  }
                }
              },
              "then": {
                "properties": {
                  "facts": {
                    "type": "object",
                    "properties": {}
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "abandon"
            },
            "subject": {
              "const": "dispatch"
            },
            "owner": {
              "const": "supervisor"
            },
            "key": {
              "type": "string"
            },
            "partition": {
              "type": [
                "string",
                "null"
              ]
            },
            "message": {
              "type": "null"
            },
            "facts": {
              "type": "object",
              "properties": {
                "reason": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "kind",
            "subject",
            "owner",
            "key"
          ]
        }
      ]
    }
  }
}
