            "sealed"
          ]
        },
        "to": {
          "enum": [
            "draft",
            "sealed"
          ]
        },
        "facts": {
          "type": "object",
          "properties": {
            "attempt_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "cause": {
              "enum": [
                "operation",
                "created",
                "external"
              ]
            },
            "commit": {
              "type": "string"
            },
            "operation": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "kind",
        "subject",
        "owner",
        "key",
        "to"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "to": {
                "enum": [
                  "draft",
                  "sealed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "facts": {
                "type": "object",
                "properties": {
                  "attempt_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "cause": {
                    "enum": [
                      "operation",
                      "created",
                      "external"
                    ]
                  },
                  "commit": {
                    "type": "string"
                  },
                  "operation": {
                    "type": "string"
                  }
                },
                "required": [
                  "cause"
                ]
              }
            },
            "required": [
              "facts"
            ]
          }
        }
      ],
      "description": "The author REE's committed state: authored while draft, frozen once sealed. Evidence: git."
    },
    "Step": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "transition"
        },
        "subject": {
          "const": "Step"
        },
        "owner": {
          "const": "core"
        },
        "key": {
          "type": "string"
        },
        "partition": {
          "type": [
            "string",
            "null"
          ]
        },
        "from": {
          "enum": [
            null,
            "missing",
            "current",
            "stale",
            "not_applicable"
          ]
        },
        "to": {
          "enum": [
            "missing",
            "current",
            "stale",
            "not_applicable"
          ]
        },
        "facts": {
          "type": "object",
          "properties": {
            "attempt_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "cause": {
              "enum": [
                "operation",
                "external",
                "baseline"
              ]
            },
            "kind": {
              "enum": [
                "source",
                "evaluation",
                "hardware",
                "runtime",
                "sbom",
                "sbom_cross_check",
                "test_activation",
                "experiment"
              ]
            },
            "operation": {
              "type": [
                "string",
                "null"
              ]
            },
            "step": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "kind",
        "subject",
        "owner",
        "key",
        "to"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "to": {
                "enum": [
                  "current",
                  "missing",
                  "not_applicable",
                  "stale"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "facts": {
                "type": "object",
                "properties": {
                  "attempt_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "cause": {
                    "enum": [
                      "operation",
                      "external",
                      "baseline"
                    ]
                  },
                  "kind": {
                    "enum": [
                      "source",
                      "evaluation",
                      "hardware",
                      "runtime",
                      "sbom",
                      "sbom_cross_check",
                      "test_activation",
                      "experiment"
                    ]
                  },
                  "operation": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "step": {
