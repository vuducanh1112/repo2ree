          "type": "object"
        }
      },
      "title": "HardwareDefinition",
      "type": "object"
    },
    "MemoryDefinition": {
      "additionalProperties": false,
      "properties": {
        "vendor": {
          "default": "",
          "description": "Memory module manufacturer, for example Samsung or Micron.",
          "title": "Vendor",
          "type": "string"
        },
        "quantity": {
          "default": 1,
          "description": "Number of identical memory modules installed in the machine.",
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "capacity_gb": {
          "default": 0,
          "description": "Capacity of one memory module in gibibytes/gigabytes as recorded.",
          "minimum": 0,
          "title": "Capacity Gb",
          "type": "number"
        },
        "memory_type": {
          "default": "DDR5",
          "description": "Memory technology used by the module.",
          "enum": [
            "DDR3",
            "DDR4",
            "DDR5",
            "LPDDR4",
            "LPDDR5",
            "HBM2",
            "HBM2e",
            "HBM3"
          ],
          "title": "Memory Type",
          "type": "string"
        },
        "speed_mt_s": {
          "default": 0,
          "description": "Rated transfer speed of one memory module in MT/s.",
          "minimum": 0,
          "title": "Speed Mt S",
          "type": "integer"
        },
        "extra_info": {
          "additionalProperties": true,
          "description": "Additional memory metadata that does not fit the structured memory schema.",
          "title": "Extra Info",
          "type": "object"
        }
      },
      "title": "MemoryDefinition",
      "type": "object"
    },
    "NetworkDefinition": {
      "additionalProperties": false,
      "properties": {
        "vendor": {
          "default": "",
          "description": "Network interface manufacturer, for example Intel, Broadcom, or Mellanox.",
          "title": "Vendor",
          "type": "string"
