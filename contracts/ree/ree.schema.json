{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repo2ree:ree:1",
  "$defs": {
    "AcquireSourceReceipt": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "finished_at": {
          "format": "date-time",
          "title": "Finished At",
          "type": "string"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "operation": {
          "const": "acquire_source",
          "default": "acquire_source",
          "title": "Operation",
          "type": "string"
        },
        "origin_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin Url"
        },
        "source_type": {
          "enum": [
            "",
            "git",
            "hg",
            "svn",
            "cvs",
            "bzr",
            "tarball",
            "zip"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "requested_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested Ref"
        },
        "resolved_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved Revision"
        },
        "observed_swhid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Swhid"
        },
        "snapshot_digest": {
          "title": "Snapshot Digest",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "started_at",
        "finished_at",
        "duration_ms",
        "recorded_at",
        "source_type",
        "snapshot_digest"
      ],
      "title": "AcquireSourceReceipt",
      "type": "object"
    },
    "BuildRuntimeDefinition": {
      "additionalProperties": false,
      "description": "The build recipe: the script that runs, and what running it must leave.\n\n``runtime_path`` is where the build is expected to write its runtime, and it\nis optional only because a fresh REE is seeded with this script before it\nhas a source — there is nothing yet to say where the artifact will land.\nDeclaring it is an authoring act, and the build step refuses to run until it\nhappens; a build with nowhere to look produces no evidence anyone can check.",
      "properties": {
        "build_runtime_script_path": {
          "default": "ree-scripts/build_script.sh",
          "title": "Build Runtime Script Path",
          "type": "string"
        },
        "build_runtime_script_digest": {
          "title": "Build Runtime Script Digest",
          "type": "string"
        },
        "build_runtime_script_size": {
          "minimum": 0,
          "title": "Build Runtime Script Size",
          "type": "integer"
        },
        "runtime_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Path"
        }
      },
      "required": [
        "build_runtime_script_digest",
        "build_runtime_script_size"
      ],
      "title": "BuildRuntimeDefinition",
      "type": "object"
    },
    "BuildRuntimeReceipt": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "finished_at": {
          "format": "date-time",
          "title": "Finished At",
          "type": "string"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "operation": {
          "const": "build_runtime",
          "default": "build_runtime",
          "title": "Operation",
          "type": "string"
        },
        "snapshot_digest": {
          "title": "Snapshot Digest",
          "type": "string"
        },
        "build_runtime_script_path": {
          "title": "Build Runtime Script Path",
          "type": "string"
        },
        "build_runtime_script_digest": {
          "title": "Build Runtime Script Digest",
          "type": "string"
        },
        "workspace_drift": {
          "$ref": "#/$defs/WorkspaceDrift"
        },
        "runtime_path": {
          "title": "Runtime Path",
          "type": "string"
        },
        "produced_runtime_digest": {
          "title": "Produced Runtime Digest",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "started_at",
        "finished_at",
        "duration_ms",
        "recorded_at",
        "snapshot_digest",
        "build_runtime_script_path",
        "build_runtime_script_digest",
        "workspace_drift",
        "runtime_path",
        "produced_runtime_digest"
      ],
      "title": "BuildRuntimeReceipt",
      "type": "object"
    },
    "BundleContents": {
      "additionalProperties": false,
      "description": "Materialized payload inventory bound by the seal.\n\nCapture-policy version 2 uses repository-relative paths and actual LFS\npayload digests, excluding Git storage and the self-containing manifest.\nLegacy inventories retain their original portable-archive path semantics.\nDraft inventories are historical observations, not availability guarantees.",
      "properties": {
        "entries": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BundleEntry"
          },
          "title": "Entries",
          "type": "array"
        }
      },
      "title": "BundleContents",
      "type": "object"
    },
    "BundleEntry": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "digest": {
          "title": "Digest",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "digest",
        "size"
      ],
      "title": "BundleEntry",
      "type": "object"
    },
    "CPUDefinition": {
      "additionalProperties": false,
      "properties": {
        "vendor": {
          "default": "",
          "description": "CPU manufacturer, for example Intel or AMD.",
          "title": "Vendor",
          "type": "string"
        },
        "quantity": {
          "default": 1,
          "description": "Number of identical CPU packages installed in the machine.",
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "cores_per_cpu": {
          "default": 1,
          "description": "Number of physical CPU cores provided by one CPU package.",
          "minimum": 1,
          "title": "Cores Per Cpu",
          "type": "integer"
        },
        "threads_per_core": {
          "default": 1,
          "description": "Hardware threads exposed by each physical CPU core.",
          "minimum": 1,
          "title": "Threads Per Core",
          "type": "integer"
        },
        "architecture": {
          "default": "",
          "description": "Instruction set architecture, for example x86_64 or arm64.",
          "title": "Architecture",
          "type": "string"
        },
        "extra_info": {
          "additionalProperties": true,
          "description": "Additional CPU metadata that does not fit the structured CPU schema.",
          "title": "Extra Info",
          "type": "object"
        }
      },
      "title": "CPUDefinition",
      "type": "object"
    },
    "CapturePolicy": {
      "additionalProperties": false,
      "description": "Versioned payload inclusion, independent of a transient Git index.",
      "properties": {
        "version": {
          "const": 2,
          "default": 2,
          "title": "Version",
          "type": "integer"
        },
        "lfs_paths": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Lfs Paths",
          "type": "array"
        }
      },
      "title": "CapturePolicy",
      "type": "object"
    },
    "Contributor": {
      "additionalProperties": false,
      "properties": {
        "identifier": {
          "default": "",
          "title": "Identifier",
          "type": "string"
        },
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        },
        "affiliation_name": {
          "default": "",
          "title": "Affiliation Name",
          "type": "string"
        },
        "affiliation_identifier": {
          "default": "",
          "title": "Affiliation Identifier",
          "type": "string"
        }
      },
      "title": "Contributor",
      "type": "object"
    },
    "CrossCheckSbomReceipt": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "finished_at": {
          "format": "date-time",
          "title": "Finished At",
          "type": "string"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "operation": {
          "const": "cross_check_sbom",
          "default": "cross_check_sbom",
          "title": "Operation",
          "type": "string"
        },
        "sbom_digest": {
          "title": "Sbom Digest",
          "type": "string"
        },
        "report_digest": {
          "title": "Report Digest",
          "type": "string"
        },
        "declared_direct_total": {
          "minimum": 0,
          "title": "Declared Direct Total",
          "type": "integer"
        },
        "observed_matched": {
          "minimum": 0,
          "title": "Observed Matched",
          "type": "integer"
        },
        "version_mismatches": {
          "minimum": 0,
          "title": "Version Mismatches",
          "type": "integer"
        },
        "undeclared_same_ecosystem": {
          "minimum": 0,
          "title": "Undeclared Same Ecosystem",
          "type": "integer"
        },
        "observed_total": {
          "minimum": 0,
          "title": "Observed Total",
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "started_at",
        "finished_at",
        "duration_ms",
        "recorded_at",
        "sbom_digest",
        "report_digest",
        "declared_direct_total",
        "observed_matched",
        "version_mismatches",
        "undeclared_same_ecosystem",
        "observed_total"
      ],
      "title": "CrossCheckSbomReceipt",
      "type": "object"
    },
    "EvaluateReproducibilityReceipt": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "finished_at": {
          "format": "date-time",
          "title": "Finished At",
          "type": "string"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "operation": {
          "const": "evaluate_reproducibility",
          "default": "evaluate_reproducibility",
          "title": "Operation",
          "type": "string"
        },
        "snapshot_digest": {
          "title": "Snapshot Digest",
          "type": "string"
        },
        "overlay_digest": {
          "title": "Overlay Digest",
          "type": "string"
        },
        "strict": {
          "title": "Strict",
          "type": "boolean"
        },
        "dependency_level": {
          "minimum": 0,
          "title": "Dependency Level",
          "type": "integer"
        },
        "environment_level": {
          "minimum": 0,
          "title": "Environment Level",
          "type": "integer"
        },
        "machine_level": {
          "minimum": 0,
          "title": "Machine Level",
          "type": "integer"
        },
        "dependency_count": {
          "minimum": 0,
          "title": "Dependency Count",
          "type": "integer"
        },
        "manifest_count": {
          "minimum": 0,
          "title": "Manifest Count",
          "type": "integer"
        },
        "report_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Path"
        },
        "report_digest": {
          "title": "Report Digest",
          "type": "string"
        },
        "analyzer_version": {
          "minLength": 1,
          "title": "Analyzer Version",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "started_at",
        "finished_at",
        "duration_ms",
        "recorded_at",
        "snapshot_digest",
        "overlay_digest",
        "strict",
        "dependency_level",
        "environment_level",
        "machine_level",
        "dependency_count",
        "manifest_count",
        "report_digest",
        "analyzer_version"
      ],
      "title": "EvaluateReproducibilityReceipt",
      "type": "object"
    },
    "ExperimentDefinition": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "run_script_path": {
          "title": "Run Script Path",
          "type": "string"
        },
        "run_script_digest": {
          "title": "Run Script Digest",
          "type": "string"
        },
        "run_script_size": {
          "minimum": 0,
          "title": "Run Script Size",
          "type": "integer"
        },
        "verify_script_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verify Script Path"
        },
        "verify_script_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verify Script Digest"
        },
        "verify_script_size": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verify Script Size"
        },
        "output_paths": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Output Paths",
          "type": "array"
        }
      },
      "required": [
        "name",
        "run_script_path",
        "run_script_digest",
        "run_script_size"
      ],
      "title": "ExperimentDefinition",
      "type": "object"
    },
    "GPUDefinition": {
      "additionalProperties": false,
      "properties": {
        "vendor": {
          "default": "",
          "description": "GPU manufacturer, for example NVIDIA or AMD.",
          "title": "Vendor",
          "type": "string"
        },
        "quantity": {
          "default": 1,
          "description": "Number of identical GPUs installed in the machine.",
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "memory_gb": {
          "default": 0,
          "description": "On-board memory capacity of one GPU in gibibytes/gigabytes as recorded.",
          "minimum": 0,
          "title": "Memory Gb",
          "type": "number"
        },
        "interface": {
          "default": "",
          "description": "Host interconnect used by the GPU, for example PCIe 4.0 x16 or SXM4.",
          "title": "Interface",
          "type": "string"
        },
        "extra_info": {
          "additionalProperties": true,
          "description": "Additional GPU metadata that does not fit the structured GPU schema.",
          "title": "Extra Info",
          "type": "object"
        }
      },
      "title": "GPUDefinition",
      "type": "object"
    },
    "GenerateSbomReceipt": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
