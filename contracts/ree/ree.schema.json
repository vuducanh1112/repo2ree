        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "operation": {
          "const": "generate_sbom",
          "default": "generate_sbom",
          "title": "Operation",
          "type": "string"
        },
        "runtime_path": {
          "title": "Runtime Path",
          "type": "string"
        },
        "runtime_digest": {
          "title": "Runtime Digest",
          "type": "string"
        },
        "sbom_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sbom Path"
        },
        "sbom_digest": {
          "title": "Sbom Digest",
          "type": "string"
        },
        "sbom_format": {
          "minLength": 1,
          "title": "Sbom Format",
          "type": "string"
        },
        "tool_version": {
          "minLength": 1,
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "started_at",
        "finished_at",
        "duration_ms",
        "recorded_at",
        "runtime_path",
        "runtime_digest",
        "sbom_digest",
        "sbom_format",
        "tool_version"
      ],
      "title": "GenerateSbomReceipt",
      "type": "object"
    },
    "HBOM": {
      "additionalProperties": false,
      "properties": {
        "cpus": {
          "additionalProperties": {
            "$ref": "#/$defs/CPUDefinition"
          },
          "propertyNames": {
