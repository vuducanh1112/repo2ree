      echo "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20250101T000000Z trixie main" >/etc/apt/sources.list;\
      echo "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/20250101T000000Z trixie-security main" >>/etc/apt/sources.list;\
