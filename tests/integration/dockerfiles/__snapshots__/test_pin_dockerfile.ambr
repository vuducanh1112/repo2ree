      echo "deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20250101T000000Z trixie-backports main" >>/etc/apt/sources.list;\
      rm -f /etc/apt/apt.conf.d/docker-clean\
      echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' >/etc/apt/apt.conf.d/keep-cache
  
  RUN apt-get update && apt-get install -y curl=8.11.1-1 gnupg2=2.2.45-2 ca-certificates=20240203 lsb-release=12.1-1
  
  RUN python3 -m pip install requests==2.32.3
  
  
