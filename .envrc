# activate nix environment
use flake

# Point the git hook at this shell's pre-commit. The hook runs pre-commit by its
# store path, so it is installed only when it names another one (a dev-pin bump)
# or none (a fresh clone): installing on every reload let two editor reloads race
# and leave a .legacy hook that broke commits.
grep -qsF "$(command -v pre-commit)" "$(git rev-parse --git-path hooks)/pre-commit" || pre-commit install > /dev/null

watch_file nix/devshell.nix
watch_file flake.nix
watch_file flake.lock

# source python venv
watch_file uv.lock
watch_file pyproject.toml
watch_file core/pyproject.toml
watch_file api/pyproject.toml
watch_file supervisor/pyproject.toml
watch_file protocol/pyproject.toml
watch_file executor/pyproject.toml
watch_file docker-support/pyproject.toml
watch_file provider/pyproject.toml
watch_file workbench/pyproject.toml
watch_file assurance/checker/pyproject.toml
watch_file assurance/traceview/pyproject.toml
watch_file assurance/collector/pyproject.toml
watch_file assurance/dossier/pyproject.toml
watch_file testbed/pyproject.toml
watch_file repoview/pyproject.toml
if [ ! -d ".venv" ]; then
    uv venv
fi
uv sync --all-packages
source .venv/bin/activate
