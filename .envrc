# activate nix environment
use flake

# Point the git hooks at this shell's pre-commit: the installed hook runs the
# interpreter it was installed with, so after a dev-pin bump it would otherwise
# keep running the previous version, and a fresh clone would have no hooks.
pre-commit install > /dev/null

watch_file nix/devshell.nix
watch_file flake.nix
watch_file flake.lock

# source python venv
watch_file uv.lock
watch_file pyproject.toml
watch_file core/pyproject.toml
watch_file api/pyproject.toml
watch_file supervisor/pyproject.toml
watch_file protocol/pyproject.toml
watch_file executor/pyproject.toml
watch_file docker-support/pyproject.toml
watch_file provider/pyproject.toml
watch_file workbench/pyproject.toml
watch_file conformance/pyproject.toml
watch_file traceview/pyproject.toml
watch_file collect/pyproject.toml
watch_file recording/pyproject.toml
watch_file testbed/pyproject.toml
watch_file repoview/pyproject.toml
if [ ! -d ".venv" ]; then
    uv venv
fi
uv sync --all-packages
source .venv/bin/activate
