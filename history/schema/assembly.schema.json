{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/Identifier"
        },
        "kind": {
          "enum": [
            "git_repository",
            "telemetry",
            "state",
            "log",
            "screenshot",
            "video",
            "archive",
            "report"
          ],
          "title": "Kind",
          "type": "string"
        },
        "uri": {
          "$ref": "#/$defs/Identifier"
        },
        "media_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "repository_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resources": {
          "$ref": "#/$defs/Resources"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "uri"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "Attribution": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "$ref": "#/$defs/Identifier"
        },
        "ree_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "execution_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ree_support": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "title": "Ree Support",
          "type": "array"
        },
        "lifecycle_support": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "title": "Lifecycle Support",
          "type": "array"
        }
      },
      "required": [
        "event_id"
      ],
      "title": "Attribution",
      "type": "object"
    },
    "AuthenticationObserved": {
      "additionalProperties": false,
      "description": "Decision observed at the receiving boundary; no credentials or tokens.",
      "properties": {
        "kind": {
          "const": "authentication.observed",
          "default": "authentication.observed",
          "title": "Kind",
          "type": "string"
        },
        "session_id": {
          "$ref": "#/$defs/Identifier"
        },
        "request_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outcome": {
          "enum": [
            "authenticated",
            "rejected",
            "bypassed",
            "unknown"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "principal_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mechanism": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "session_id",
        "outcome",
        "mechanism"
      ],
      "title": "AuthenticationObserved",
      "type": "object"
    },
    "Boundary": {
      "additionalProperties": false,
      "description": "Readiness facts for the existing ree_layout contract, not inferred from success.",
      "properties": {
        "event": {
          "enum": [
            "operation_finished",
            "initialization_finished"
          ],
          "title": "Event",
          "type": "string"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "canceled"
          ],
          "title": "Status",
          "type": "string"
        },
        "scope": {
          "enum": [
            "author",
            "review"
          ],
          "title": "Scope",
          "type": "string"
        },
        "mutates_ree": {
          "title": "Mutates Ree",
          "type": "boolean"
        },
        "root_expected": {
          "title": "Root Expected",
          "type": "boolean"
        },
        "writers_stopped": {
          "title": "Writers Stopped",
          "type": "boolean"
        },
        "capture_prepared": {
          "title": "Capture Prepared",
          "type": "boolean"
        },
        "locks_held": {
          "title": "Locks Held",
          "type": "boolean"
        },
        "history_published": {
          "title": "History Published",
          "type": "boolean"
        },
        "capture_format": {
          "enum": [
            "repository_v2",
            "legacy",
            "none"
          ],
          "title": "Capture Format",
          "type": "string"
        }
      },
      "required": [
        "event",
        "status",
        "scope",
        "mutates_ree",
        "root_expected",
        "writers_stopped",
        "capture_prepared",
        "locks_held",
        "history_published",
        "capture_format"
      ],
      "title": "Boundary",
      "type": "object"
    },
    "BuildIdentity": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "default": "",
          "title": "Version",
          "type": "string"
        },
        "revision": {
          "default": "",
          "title": "Revision",
          "type": "string"
        }
      },
      "title": "BuildIdentity",
      "type": "object"
    },
    "CommitLocator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "commit",
          "default": "commit",
          "title": "Kind",
          "type": "string"
        },
        "commit_id": {
          "pattern": "^[0-9a-f]{40,64}$",
          "title": "Commit Id",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        }
      },
      "required": [
        "commit_id"
      ],
      "title": "CommitLocator",
      "type": "object"
    },
    "Component": {
      "enum": [
        "api",
        "supervisor",
        "provider",
        "workbench",
        "executor",
        "core",
        "client",
        "recorder"
      ],
      "type": "string"
    },
    "ConnectionObserved": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "connection.observed",
          "default": "connection.observed",
          "title": "Kind",
          "type": "string"
        },
        "session_id": {
          "$ref": "#/$defs/Identifier"
        },
        "peer": {
          "$ref": "#/$defs/Component"
        },
        "state": {
          "enum": [
            "attempted",
            "connected",
            "disconnected",
            "rejected"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "peer",
        "state"
      ],
      "title": "ConnectionObserved",
      "type": "object"
    },
    "Correlation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Event Ids",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "value",
        "event_ids"
      ],
      "title": "Correlation",
      "type": "object"
    },
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "severity": {
          "default": "incomplete",
          "enum": [
            "info",
            "incomplete",
            "invalid"
          ],
          "title": "Severity",
          "type": "string"
        },
        "ree_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "execution_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "event_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Event Ids",
          "type": "array"
        }
      },
      "required": [
        "code",
        "detail"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "EventPayload": {
      "discriminator": {
        "mapping": {
          "authentication.observed": "#/$defs/AuthenticationObserved",
          "connection.observed": "#/$defs/ConnectionObserved",
          "execution.ended": "#/$defs/ExecutionEnded",
          "execution.started": "#/$defs/ExecutionStarted",
          "git_capture.observed": "#/$defs/GitCaptureObserved",
          "interaction.observed": "#/$defs/InteractionObserved",
          "layout.observed": "#/$defs/LayoutObserved",
          "operation.completed": "#/$defs/OperationCompleted",
          "operation.started": "#/$defs/OperationStarted",
          "process.observed": "#/$defs/ProcessObserved",
          "review.observed": "#/$defs/ReviewObserved",
          "span.observed": "#/$defs/SpanObserved",
          "state.observed": "#/$defs/StateObserved"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/SpanObserved"
        },
        {
          "$ref": "#/$defs/ExecutionStarted"
        },
        {
          "$ref": "#/$defs/ExecutionEnded"
        },
        {
          "$ref": "#/$defs/ConnectionObserved"
        },
        {
          "$ref": "#/$defs/AuthenticationObserved"
        },
        {
          "$ref": "#/$defs/InteractionObserved"
        },
        {
          "$ref": "#/$defs/OperationStarted"
        },
        {
          "$ref": "#/$defs/OperationCompleted"
        },
        {
          "$ref": "#/$defs/ProcessObserved"
        },
        {
          "$ref": "#/$defs/ReviewObserved"
        },
        {
          "$ref": "#/$defs/LayoutObserved"
        },
        {
          "$ref": "#/$defs/StateObserved"
        },
        {
          "$ref": "#/$defs/GitCaptureObserved"
        }
      ]
    },
    "ExecutionEnded": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "execution.ended",
          "default": "execution.ended",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "enum": [
            "workbench_shutdown",
            "connection_failed",
            "observation_stopped"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "title": "ExecutionEnded",
      "type": "object"
    },
    "ExecutionStarted": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "execution.started",
          "default": "execution.started",
          "title": "Kind",
          "type": "string"
        },
        "trigger": {
          "enum": [
            "connection_attempt",
            "attached_to_existing_workbench"
          ],
          "title": "Trigger",
          "type": "string"
        }
      },
      "required": [
        "trigger"
      ],
      "title": "ExecutionStarted",
      "type": "object"
    },
    "FailureObservation": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "validation",
            "precondition",
            "conflict",
            "execution",
            "timeout",
            "unavailable",
            "internal"
          ],
          "title": "Category",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Component"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "details": {
          "anyOf": [
            {
              "$ref": "#/$defs/Projection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "category",
        "origin",
        "message"
      ],
      "title": "FailureObservation",
      "type": "object"
    },
    "FileEntry": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/Identifier"
        },
        "kind": {
          "enum": [
            "file",
            "directory",
            "symlink",
            "other",
            "missing",
            "unreadable"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "path",
        "kind"
      ],
      "title": "FileEntry",
      "type": "object"
    },
    "GitCaptureObserved": {
      "additionalProperties": false,
      "description": "HistoryReference plus repository identity; commit IDs are scoped to a repository.",
      "properties": {
        "kind": {
          "const": "git_capture.observed",
          "default": "git_capture.observed",
          "title": "Kind",
          "type": "string"
        },
        "repository_id": {
          "$ref": "#/$defs/Identifier"
        },
        "selection_version": {
          "minimum": 1,
          "title": "Selection Version",
          "type": "integer"
        },
        "capture_status": {
          "enum": [
            "pending",
            "captured",
            "failed"
          ],
          "title": "Capture Status",
          "type": "string"
        },
        "operation_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/Outcome"
            },
            {
              "const": "not_started",
              "type": "string"
            }
          ],
          "title": "Operation Status"
        },
        "before_snapshot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before Snapshot Id"
        },
        "after_snapshot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After Snapshot Id"
        },
        "changed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Changed"
        },
        "capture_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capture Error"
        },
        "operation_failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/FailureObservation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "repository_id",
        "selection_version",
        "capture_status",
        "operation_status"
      ],
      "title": "GitCaptureObserved",
      "type": "object"
    },
    "HistoryEvent": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 4,
          "default": 4,
          "title": "Schema Version",
          "type": "integer"
        },
        "event_id": {
          "$ref": "#/$defs/Identifier"
        },
        "execution_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "producer": {
          "$ref": "#/$defs/Producer"
        },
        "sequence": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sequence"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "operation": {
          "anyOf": [
            {
              "$ref": "#/$defs/OperationIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resources": {
          "$ref": "#/$defs/Resources"
        },
        "causes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "title": "Causes",
          "type": "array"
        },
        "trace_context": {
          "anyOf": [
            {
              "$ref": "#/$defs/TraceContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "artifact_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "title": "Artifact Ids",
          "type": "array"
        },
        "source_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "correlations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "title": "Correlations",
          "type": "array"
        },
        "payload": {
          "$ref": "#/$defs/EventPayload"
        }
      },
      "required": [
        "event_id",
        "producer",
        "payload"
      ],
      "title": "HistoryEvent",
      "type": "object"
    },
    "Identifier": {
      "minLength": 1,
      "type": "string"
    },
    "InteractionObserved": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "interaction.observed",
          "default": "interaction.observed",
          "title": "Kind",
          "type": "string"
        },
        "session_id": {
          "$ref": "#/$defs/Identifier"
        },
        "request_id": {
          "$ref": "#/$defs/Identifier"
        },
        "action": {
          "$ref": "#/$defs/Identifier"
        },
        "decision": {
          "enum": [
            "accepted",
            "rejected"
          ],
          "title": "Decision",
          "type": "string"
        },
        "authentication_event_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "session_id",
        "request_id",
        "action",
        "decision"
      ],
      "title": "InteractionObserved",
      "type": "object"
    },
    "JsonValue": {},
    "LayoutObserved": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "layout.observed",
          "default": "layout.observed",
          "title": "Kind",
          "type": "string"
        },
        "boundary": {
          "$ref": "#/$defs/Boundary"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/FileEntry"
          },
          "title": "Entries",
          "type": "array"
        },
        "coverage": {
          "enum": [
            "managed_paths",
            "full_tree"
          ],
          "title": "Coverage",
          "type": "string"
        }
      },
      "required": [
        "boundary",
        "entries",
        "coverage"
      ],
      "title": "LayoutObserved",
      "type": "object"
    },
    "OperationCompleted": {
      "additionalProperties": false,
      "description": "Local outcome; API acknowledgement is not executor completion.",
      "properties": {
        "kind": {
          "const": "operation.completed",
          "default": "operation.completed",
          "title": "Kind",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/FailureObservation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outputs": {
          "anyOf": [
            {
              "$ref": "#/$defs/Projection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "outcome"
      ],
      "title": "OperationCompleted",
      "type": "object"
    },
    "OperationIdentity": {
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
          "title": "Operation Id",
          "type": "string"
        },
        "attempt_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
          "title": "Attempt Id",
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/Identifier"
        },
        "run_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "operation_id",
        "attempt_id",
        "operation"
      ],
      "title": "OperationIdentity",
      "type": "object"
    },
    "OperationStarted": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "operation.started",
          "default": "operation.started",
          "title": "Kind",
          "type": "string"
        },
        "inputs": {
          "anyOf": [
            {
              "$ref": "#/$defs/Projection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "OperationStarted",
      "type": "object"
    },
    "Outcome": {
      "enum": [
        "succeeded",
        "failed",
        "canceled",
        "unknown"
      ],
      "type": "string"
    },
    "ProcessObserved": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "process.observed",
          "default": "process.observed",
          "title": "Kind",
          "type": "string"
        },
        "argv": {
          "title": "Argv",
          "type": "string"
        },
        "cwd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cwd"
        },
        "script_path": {
