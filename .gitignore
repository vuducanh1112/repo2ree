.direnv
.env

# Nix build output symlinks
result
result-*

# Local build artifacts
/dist/

.pytest_cache/
# Hypothesis's local example database: replays past failing cases on the next
# run, but machine-local and ephemeral. Durable regressions are pinned with
# @example in the test source, so this dir is never committed.
.hypothesis/
.venv/
**/__pycache__/

**/.DS_Store

# Local runtime state
.repo2ree/

# Test artifacts — all coverage reports/data and observability traces live
# under one gitignored root (see test-artifacts/ layout in the Makefile).
/test-artifacts/

# Coverage data files, in case a run lands one at the repo root rather than the
# configured data_file path.
.coverage
.coverage.*
coverage.xml

# Third-party capsules used as authoring inputs: large downloaded archives,
# fetched on demand rather than versioned. Everything else under examples/ —
# the source projects and REE bundles the suites read — is tracked.
/examples/code-ocean/
fastapi.log
.env.example
.vale/styles/proselint/
.vale/styles/write-good/